{
  "name": "guitar-positions-app",
  "version": "2.1.0",
  "private": true,
  "description": "Native iOS and Android shells (Capacitor) for Guitar Positions Studio. See README.md.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bundle": "${PYTHON:-python3} ../scripts/build_app_bundle.py --out www",
    "sync": "npm run bundle && cap sync",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1 --directory www",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "macos": "bash scripts/build-macos.sh",
    "icons": "${PYTHON:-python3} scripts/generate_native_icons.py"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
